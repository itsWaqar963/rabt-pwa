NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public app origin (no trailing slash). REQUIRED for reliable Web Push deep-links.
# Set in Vercel → Settings → Environment Variables (Production + Preview).
# Example: https://rabt-pwa.vercel.app
NEXT_PUBLIC_APP_URL=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Server-only — never expose as NEXT_PUBLIC_*. Used by API routes to read
# other users' push_subscriptions and send notifications.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret for Supabase Database Webhook → /api/hooks/message-inserted
# Header: Authorization: Bearer <secret>  OR  x-rabt-webhook-secret: <secret>
PUSH_WEBHOOK_SECRET=

# Server-only secret for Admin → POST /api/admin-broadcast (must match rabt-admin).
# Header: Authorization: Bearer <secret>  OR  x-rabt-admin-broadcast-secret: <secret>
ADMIN_BROADCAST_SECRET=
